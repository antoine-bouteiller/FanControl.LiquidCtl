{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: false,
  extends: [
    'config:recommended',
    ':disableRateLimiting',
    ':ignoreUnstable',
    'helpers:pinGitHubActionDigestsToSemver',
    'antoine-bouteiller/FanControl.LiquidCtl//.renovate/auto-merge.json5',
    'antoine-bouteiller/FanControl.LiquidCtl//.renovate/groups.json5',
    'antoine-bouteiller/FanControl.LiquidCtl//.renovate/semantic-commits.json5',
  ],
  ignorePresets: ['mergeConfidence:all-badges'],
  configMigration: true,
  minimumReleaseAge: '1 day',
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 5am on monday'],
  },
  packageRules: [
    {
      description: 'Keep the Conventional Commits preset compatible with release-notes-generator',
      matchPackageNames: ['conventional-changelog-conventionalcommits'],
      enabled: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ['security'],
    semanticCommitType: 'fix',
    semanticCommitScope: 'deps',
    minimumReleaseAge: null,
    schedule: ['at any time'],
  },
  gitIgnoredAuthors: ['227055450+renohate[bot]@users.noreply.github.com'],
  labels: ['renovate'],
  'pre-commit': {
    enabled: true,
  },
}
