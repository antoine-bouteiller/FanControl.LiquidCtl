{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>antoine-bouteiller/renovate'],
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 5am on monday'],
  },
  packageRules: [
    {
      description: 'Keep the Conventional Commits preset compatible with release-notes-generator',
      matchPackageNames: ['conventional-changelog-conventionalcommits'],
      enabled: false,
    },
    {
      description: 'Auto-merge npm updates without waiting for CI (no CI runs on npm dependency changes)',
      matchManagers: ['npm'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: true,
    },
    {
      // Dependencies ship in the release artifact, so bumps use `build`.
      matchManagers: ['!github-actions', '!npm'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'digest'],
      semanticCommitType: 'build',
    },
    {
      // Python and .NET ship in the release artifact, so their bumps keep the `build` type.
      matchManagers: ['mise'],
      matchPackageNames: ['!python', '!dotnet'],
      semanticCommitType: 'chore',
    },
    {
      // Everything in the test project is a dev dependency. NuGet has no
      // devDependencies depType, so match the test project file instead.
      matchFileNames: ['**/*.Tests.csproj'],
      semanticCommitType: 'test',
      semanticCommitScope: 'deps',
    },
  ],
}
