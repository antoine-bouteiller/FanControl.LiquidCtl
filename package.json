{
  "name": "fancontrol-liquidctl",
  "version": "2.6.1",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "lint": "lefthook run pre-commit",
    "format": "pnpm oxfmt . && uv run --project src/liquidctl_server ruff format src/liquidctl_server && dotnet format src/FanControl.Liquidctl/FanControl.Liquidctl.csproj"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "semantic-release": "25.0.8"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@11.25.0"
}
